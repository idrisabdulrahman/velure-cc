    "@types/qrcode": "1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-orm": "^0.45.2",
    "jsdom": "^27.0.0",
    "kysely": "^0.28.17",
    "shadcn": "^4.19.0",
    "typescript": "^5.7.2",
    "vite": "^7.0.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.0"
  },
  "packageManager": "pnpm@10.32.1"
}
