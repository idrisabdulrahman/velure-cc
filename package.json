{
  "name": "invoicly",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": " vite --host 0.0.0.0 --port 3000 --strictPort",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 vite build",
    "build:pages": "NODE_OPTIONS=--max-old-space-size=4096 NITRO_PRESET=cloudflare_pages vite build",
    "deploy:pages": "pnpm build:pages && npx wrangler pages deploy dist --project-name velure --branch main --env-file .env",
    "build:worker": "NODE_OPTIONS=--max-old-space-size=4096 NITRO_PRESET=cloudflare_module vite build",
    "deploy:worker": "pnpm build:worker && npx wrangler deploy",
    "deploy:hasher": "npx wrangler deploy --config deploy/password-hasher/wrangler.jsonc",
    "start": "HOST=0.0.0.0 node .output/server/index.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "supabase:types": "supabase gen types typescript --linked --schema public > src/types/database.types.ts",
    "guard:supabase-schema": "node scripts/verify-supabase-schema.mjs",
    "guard:anon-privileges": "node scripts/guard-anon-privileges.mjs",
    "guard:identity-continuity": "node scripts/bridge-proof/identity-continuity.mjs",
    "test:a11-removal": "node scripts/verify-a11-removal.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "hooks:pre-commit": "biome check --staged && pnpm typecheck && pnpm test",
    "hooks:pre-push": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:a10-workspaces-live": "A10_LIVE=1 vitest run src/server/data/workspaces.live.test.ts",
    "test:a10-clients-live": "A10_LIVE=1 vitest run src/server/data/clients.live.test.ts",
    "test:a10-products-live": "A10_LIVE=1 vitest run src/server/data/products.live.test.ts",
    "test:a10-invoices-live": "A10_LIVE=1 vitest run src/server/data/invoices.live.test.ts",
    "test:a10-payments-live": "A10_LIVE=1 vitest run src/server/data/payments.live.test.ts",
    "test:a10-reminders-live": "A10_LIVE=1 vitest run src/server/data/reminders.live.test.ts",
    "test:a10-integrations-live": "A10_LIVE=1 vitest run src/server/data/integrations.live.test.ts",
    "test:a10-tenancy-live": "A10_LIVE=1 vitest run src/server/data/rls-tenancy.live.test.ts",
    "test:wp3-tenant-isolation-live": "A10_LIVE=1 vitest run src/server/data/tenant-isolation.live.test.ts",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "prepare": "git config core.hooksPath .githooks || true",
    "migrate:better-auth": "node scripts/migrate-convex-better-auth-to-postgres.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@date-fns/tz": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/geist-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@number-flow/react": "^0.6.2",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.111.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.105.2",
    "@tanstack/react-router": "1.170.28",
    "@tanstack/react-start": "1.168.45",
    "@tanstack/router-plugin": "1.168.45",
    "@tiptap/extension-link": "^2.27.3",
    "@tiptap/extension-placeholder": "^2.27.3",
    "@tiptap/extension-underline": "^2.27.3",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/react": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "better-auth": "1.4.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "cookie": "^1.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.43.0",
    "gsap": "^3.15.0",
    "jose": "6.2.3",
    "lenis": "^1.3.27",
    "lucide-react": "^0.561.0",
    "motion": "^13.5.1",
    "nitro": "npm:nitro-nightly@3.0.1-20261101-163719-5b140142",
    "pg": "^8.23.1",
    "postcss": "^8.5.32",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-day-picker": "9.8.0",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "recharts": "^3.10.1",
    "resend": "^6.37.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@playwright/test": "1.58.2",
    "@types/node": "^25.9.9",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-orm": "^0.45.4",
    "jsdom": "^27.4.0",
    "kysely": "^0.28.19",
    "shadcn": "^4.23.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@10.32.1"
}
