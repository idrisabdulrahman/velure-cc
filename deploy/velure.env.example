# Velure environment file — copy to /etc/velure/velure.env
#
#   sudo install -d -m 0755 /etc/velure
#   sudo cp deploy/velure.env.example /etc/velure/velure.env
#   sudo chown root:root /etc/velure/velure.env
#   sudo chmod 600 /etc/velure/velure.env
#   # then edit it and fill in the real values
#
# systemd's EnvironmentFile syntax, NOT shell:
#   * KEY=value, one per line, no leading `export`
#   * no variable expansion, no command substitution
#   * wrap a value that contains spaces or JSON in single quotes
#   * comments start with `#`
#
# Never commit this file. `deploy/velure.env.example` is the committed template.

# --- Required -------------------------------------------------------------

# Supabase transaction-mode pooler (port 6543). The `search_path=better_auth`
# option is applied by the app, so use the plain connection string.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Must be at least 32 characters. The app refuses to boot with a shorter one.
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-a-32-plus-character-random-secret

# The public HTTPS origin. Both must be the real domain: better-auth trusts
# exactly these origins for CSRF/origin checks and derives the cookie domain.
BETTER_AUTH_URL=https://velure.variadic.ng
SITE_URL=https://velure.variadic.ng

# Transactional email. Wrap the value in quotes: it contains spaces and <>.
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL='Velure <invoices@velure.variadic.ng>'

# 64 hex characters (32 bytes). Required in production; without it every
# integration-token encryption call throws. Generate with: openssl rand -hex 32
INTEGRATION_ENCRYPTION_KEY=replace-with-64-hex-characters

# --- Supabase -------------------------------------------------------------
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace_me
VITE_SUPABASE_URL=https://PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Single-quote the JWK: it is JSON containing double quotes and braces.
SUPABASE_JWT_PRIVATE_JWK='{"kty":"EC","kid":"...","crv":"P-256","d":"...","x":"...","y":"..."}'

# --- Payments -------------------------------------------------------------
PAYSTACK_SECRET_KEY=sk_live_replace_me
PAYSTACK_PUBLIC_KEY=pk_live_replace_me

# --- Scheduler ------------------------------------------------------------
# Must match the secret stored in Supabase Vault for the pg_cron/pg_net job that
# posts to /api/cron/tick. At least 32 characters.
INVOICE_SCHEDULER_SECRET=replace-with-a-32-plus-character-random-secret

# --- Optional integrations ------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Runtime --------------------------------------------------------------
# Use a real `pg.Pool`. Required on a long-lived Node host: without it every
# authenticated request opens a fresh Supabase connection (~1-2 s). Leave unset
# (or any other value) when deploying to Cloudflare Workers.
AUTH_DB_MODE=pool
