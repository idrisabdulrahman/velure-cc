# Velure issuer env — written to /etc/velure-issuer.env (chmod 600) by setup-vm.sh.
# The DATABASE_URL/BETTER_AUTH_SECRET/CLIENT_* values MUST match the current
# velure-cc issuer exactly — especially BETTER_AUTH_SECRET: the jwks key in
# better_auth.jwks is encrypted with it, and it must NEVER change.

# Public https URL (Caddy hostname), e.g. https://velure-auth.duckdns.org
ISSUER_URL=https://velure-auth.example.duckdns.org

# velure-cc pooler connection, better_auth least-privilege role
# postgresql://better_auth.<project-ref>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# >= 32 chars; also encrypts jwks private keys. NEVER change after first boot.
BETTER_AUTH_SECRET=

PORT=8788
CLIENT_ID=velure-supabase-client

# must match the Supabase custom-provider client_secret exactly
BRIDGE_ADMIN_TOKEN=
CLIENT_SECRET=

# comma-separated; default is the velure-cc GoTrue callback
REDIRECT_URIS=https://kbexydkmmfabfutgkbxn.supabase.co/auth/v1/callback

# optional: real email verification via Resend
# RESEND_API_KEY=
# RESEND_FROM=Velure <no-reply@velure.app>
