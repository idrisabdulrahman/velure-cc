{
	"$schema": "https://biomejs.dev/schemas/2.2.4/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"src/**/*",
			"convex/**/*.ts",
			"convex/**/*.tsx",
			".vscode/**/*",
			"index.html",
			"vite.config.ts",
			"!extracted",
			"!packages",
			"!convex/_generated",
			"!src/routeTree.gen.ts",
			"!src/types/database.types.ts",
			"!src/styles.css"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"a11y": {
				"useAriaPropsSupportedByRole": "off",
				"useSemanticElements": "off"
			},
			"correctness": {
				"noNestedComponentDefinitions": "off",
				"useUniqueElementIds": "off",
				"useExhaustiveDependencies": "off"
			},
			"suspicious": {
				"noUnknownAtRules": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	}
}
