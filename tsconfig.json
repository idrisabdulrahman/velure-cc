{
  "include": ["src/**/*.ts", "src/**/*.tsx", "convex/**/*.ts", "convex/**/*.tsx", "vite.config.ts"],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "ignoreDeprecations": "5.0",
    "paths": {
      "#/*": ["./src/*"],
      "#convex/*": ["./convex/*"],
      "@midday/ui/*": ["./src/components/ui/*"],
      "@midday/utils/*": ["./src/shims/midday-utils/*"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client","node"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
