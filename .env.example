CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=

# Public application URL
SITE_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Generate a secret key with Better Auth CLI.
BETTER_AUTH_SECRET=
# Bump to invalidate all Better Auth session-cache cookies after a deploy.
AUTH_SESSION_VERSION=1

# Google OAuth configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Convex site backend used by Better Auth bridge
VITE_CONVEX_SITE_URL=

# Transactional email configuration
RESEND_API_KEY=
RESEND_FROM=Velure <invoices@example.com>
RESEND_WEBHOOK_SECRET=
SLACK_WEBHOOK_URL=

# Accounting integrations
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_ENV=sandbox
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# Payment collection
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
