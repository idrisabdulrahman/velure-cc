# Bachs payment pilot. Configure exactly ONE env set (sandbox or live) —
# a mixed set fails closed. Provision an NGN one-time product under the
# seller and bind that seller to one workspace.
# Register /api/payments/bachs/webhook for checkout.completed.
BACHS_API_KEY=
BACHS_WEBHOOK_SECRET=
BACHS_SANDBOX_WORKSPACE_ID=
BACHS_SANDBOX_ACCOUNT_ID=
BACHS_SANDBOX_PRODUCT_ID=
BACHS_SANDBOX_RETURN_ORIGIN=

# Bachs production. Same shape as the sandbox set with an sk_live_ key against
# https://api.bachs.io. Never set both the sandbox and the live set in one
# deployment: a mixed configuration fails closed. Create the NGN product and
# register the webhook endpoint again in production; nothing carries over.
BACHS_LIVE_API_KEY=
BACHS_LIVE_WEBHOOK_SECRET=
BACHS_LIVE_WORKSPACE_ID=
BACHS_LIVE_ACCOUNT_ID=
BACHS_LIVE_PRODUCT_ID=
BACHS_LIVE_RETURN_ORIGIN=
