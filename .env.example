# Convex configuration, get this URL from your [Dashboard](dashboard.convex.dev)
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=

# Public application URL
SITE_URL=http://localhost:3000

# Better Auth configuration
BETTER_AUTH_URL=http://localhost:3000
# Optional explicit auth base URL if you need it to differ from BETTER_AUTH_URL.
BETTER_AUTH_BASE_URL=
# Generate a secret key: `pnpm dlx @better-auth/cli secret`
BETTER_AUTH_SECRET=

# Google OAuth configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Convex site backend used by Better Auth bridge
VITE_CONVEX_SITE_URL=

# Transactional email configuration
RESEND_API_KEY=
RESEND_FROM="Velure <onboarding@resend.dev>"
