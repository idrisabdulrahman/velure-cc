[TEMPLATE]
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=

# Public application URL
SITE_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Generate a secret key with Better Auth CLI.
BETTER_AUTH_SECRET=
# Bump to invalidate all Better Auth session-cache cookies after a deploy.
AUTH_SESSION_VERSION=1

# Google OAuth configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Convex site backend used by Better Auth bridge
VITE_CONVEX_SITE_URL=

# Transactional email configuration
RESEND_API_KEY=
RESEND_FROM=Velure <invoices@example.com>
RESEND_WEBHOOK_SECRET=
SLACK_WEBHOOK_URL=

# Accounting integrations
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_ENV=sandbox
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# Encryption key for sensitive integration tokens (64 hex chars / 32 bytes)
INTEGRATION_ENCRYPTION_KEY=

# Payment collection
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Supabase configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Production better-auth standalone issuer (A9 runtime shape, scripts/bridge-proof/production-issuer.mjs)
# ISSUER_URL=  # public issuer URL, e.g. https://auth.velure.app
# DATABASE_URL=  # velure-cc direct Postgres connection; search_path pinned to better_auth by the server
# CLIENT_ID=
# CLIENT_SECRET=
# REDIRECT_URIS=https://<ref>.supabase.co/auth/v1/callback
# BRIDGE_ADMIN_TOKEN=
