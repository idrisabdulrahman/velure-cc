{
	"files.watcherExclude": {
		"**/node_modules": true,
		"**/.git": true,
		"**/dist": true,
		"**/build": true,
		"**/.mimocode": true,
		"**/.codex": true,
		"**/.agents": true
	},
	"search.exclude": {
		"**/node_modules": true,
		"**/.git": true,
		"**/dist": true,
		"**/build": true,
		"**/.mimocode": true,
		"**/.codex": true,
		"**/.agents": true
	},
	"files.exclude": {
		"**/node_modules": true,
		"**/.git": true,
		"**/dist": true,
		"**/build": true
	},
	"files.readonlyInclude": {
		"**/routeTree.gen.ts": true
	},
	"[javascript]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[javascriptreact]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[typescript]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[typescriptreact]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[json]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[jsonc]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[css]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"editor.codeActionsOnSave": {
		"source.organizeImports.biome": "explicit"
	},
	"editor.defaultFormatter": "biomejs.biome",
	"editor.formatOnSave": true,
	"editor.formatOnSaveMode": "file"
}
